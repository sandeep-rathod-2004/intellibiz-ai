APP_NAME=IntelliBiz AI
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./intellibiz.db
AUTO_CREATE_SCHEMA=true
DATA_STORAGE_BACKEND=local
SUPABASE_STORAGE_DRIVER=rest
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=intellibiz-datasets
# Current REST storage readiness needs one server-side key: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_S3_ENDPOINT_URL=https://rxoxymrcccaqxbmqfazp.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=15
MAX_ROWS=100000
MAX_DATASET_CELLS=1000000
MAX_XLSX_UNCOMPRESSED_MB=128
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1200
COPILOT_TOKEN_BUDGET=1200
COPILOT_MAX_CONTEXT_CHARS=12000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LOGIN_REQUESTS_PER_MINUTE=20
REGISTRATION_REQUESTS_PER_HOUR=10
COPILOT_REQUESTS_PER_MINUTE=30

# Production deployment overrides (set in the deployment environment):
# ENVIRONMENT=production
# SECRET_KEY=<unique random value of at least 32 characters>
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# AUTO_CREATE_SCHEMA=false
# DATA_STORAGE_BACKEND=supabase
# SUPABASE_STORAGE_DRIVER=rest
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_STORAGE_BUCKET=<private bucket>
# Configure either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY above.
# CORS_ORIGINS=https://<frontend-origin>
# RUN_MIGRATIONS=true  # Optional; set only to run Alembic at production startup.
